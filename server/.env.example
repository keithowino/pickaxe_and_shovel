NODE_ENV=development
PORT=5000
MONGODB_URI=<your-mongodb-connection-string>

JWT_ACCESS_SECRET=replace_this_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=pickaxe-and-shovel
JWT_AUDIENCE=pickaxe-and-shovel-client

CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# Github configuration
# Important: Use a separate encryption key in production. If the key is lost or changed, existing encrypted tokens cannot be decrypted unless you retain the original key.
GITHUB_TOKEN_ENCRYPTION_KEY=replace_with_a_32_byte_key_encoded_as_64_hex_characters

# Messaging
RESEND_API_KEY=your_resend_api_key
CONTACT_NOTIFICATION_EMAIL=your_contact_email
RESEND_FROM_EMAIL=your_site_name <onboarding@resend.dev>
