@projectIdA = 6ac2cf95d142a2a5324eb13f
@projectIdB = 6abd1534ca1fbaf31b5dd5a6

@categoryId = 6ac12d93cc829113f2b9cf69

### Set project as unpublished

PATCH {{baseUrl}}/admin/projects/{{projectIdA}}
Content-Type: application/json
Cookie: accessToken={{adminCookie}}

{
    "published": true
}

### 1. List all projects

GET {{baseUrl}}/admin/projects
Cookie: accessToken={{adminCookie}}

### 2. Retrieve administrative statistics

GET {{baseUrl}}/admin/projects/stats
Cookie: accessToken={{adminCookie}}

### 3. Create a project

POST {{baseUrl}}/admin/projects
Content-Type: application/json
Cookie: accessToken={{adminCookie}}

{
    "name": "Project API Test",
    "description": "A temporary project created to test the Project API.",
    "githubUrl": "https://github.com/example/project-api-test",
    "liveUrl": "https://example.com",
    "primaryLanguage": "JavaScript",
    "techStack": ["React", "Node.js"],
    "topics": ["testing", "portfolio"],
    "category": "{{categoryId}}",
    "pinned": false,
    "featured": false,
    "published": true
}

### 4. Update a project

PATCH {{baseUrl}}/admin/projects/{{projectIdA}}
Content-Type: application/json
Cookie: accessToken={{adminCookie}}

{
    "name": "R4 Hub Platform",
    "description": "Updated description for the Project API test."
}

# {
#     "description": "Updated description for the Project API test.", 
#     "category": "{{projectIdA}}"
# }

### 5. Delete a project

DELETE {{baseUrl}}/admin/projects/{{projectIdA}}
Cookie: accessToken={{adminCookie}}

### 6. Successfully reorder projects

PATCH {{baseUrl}}/admin/projects/order
Content-Type: application/json
Cookie: accessToken={{adminCookie}}

{
  "orderedProjectIds": [
    "{{projectIdA}}", 
    "{{projectIdB}}"
  ]
}

### 7. Retrieve unpublished project administratively

GET {{baseUrl}}/admin/projects/{{projectIdA}}
Cookie: accessToken={{adminCookie}}